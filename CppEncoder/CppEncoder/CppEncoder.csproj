<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Frogman Engine GDK C++ Source Encoder</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.usit.FrogmanEngineGDKCppEncoder</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Unknown Stryker Interactive Technology</ApplicationPublisher>
    <Company>Unknown Stryker Interactive Technology</Company>
    <Authors>Unknown Stryker</Authors>
    <Copyright>Copyright © 2023 Unknown Stryker Interactive Technology</Copyright>
    <Trademark>Frogman Engine is a trademark of Unknown Stryker Interactive Technology</Trademark>

    <!-- Package Description -->
    <Description>Frogman Engine GDK C++ Source Encoder.</Description>
    <Icon>Assets\Icons\icon.ico</Icon>

    <!--
      If you encounter this error message:

        error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
        Please update to a newer .NET SDK in order to reference this assembly.

      This means that the two packages below must be aligned with the "build" version number of
      the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
      must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <WindowsSdkPackageVersion>10.0.22621.28</WindowsSdkPackageVersion> -->

    <!--
      UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
      https://aka.platform.uno/singleproject-features
    -->

    <UnoFeatures>
      Lottie;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      Navigation;
      ThemeService;
    </UnoFeatures>

    <Platforms>AnyCPU;x64;ARM64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Assets\Icons\fe.svg" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ude.NetStandard" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\Splash\" />
  </ItemGroup>

  <PropertyGroup>
      <PublishReadyToRun>false</PublishReadyToRun>
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

</Project>
